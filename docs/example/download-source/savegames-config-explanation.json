{
  "api": {
    "baseUrl": "https://m.suancaixianyu.cn",
    "endpoint": {
      "headers": {
        "Accept": "application/json",
        "User-Agent": "SCLauncher/1.0"
      },
      "method": "GET",
      "pagination": {
        "limitParam": "limit",
        "pageParam": "page",
        "paramLocation": "url",
        "searchParam": "title"
      },
      "url": "/api/post/list?type=2\u0026orderType=1\u0026fileTypes=1\u0026page={page}\u0026limit={limit}"
    },
    "responseMapping": {
      "author": "$.creator.nickname",
      "authorAvatar": "$.creator.headImg",
      "cover": "$.cover",
      "description": "$.content",
      "downloadUrl": "$.files[0].url",
      "fileName": "$.files[0].filename",
      "fileSize": "$.files[0].size",
      "icon": "$.files[0].icon",
      "id": "$.id",
      "likes": "$.likeCount",
      "results": "$.data.list",
      "title": "$.title",
      "total": "$.data.total",
      "totalPages": "$.data.totalPages",
      "version": "$.version",
      "versions": "$.postVersions",
      "views": "$.views"
    },
    "search": {
      "headers": {
        "Accept": "application/json",
        "User-Agent": "SCLauncher/1.0"
      },
      "method": "GET",
      "pagination": {
        "limitParam": "limit",
        "pageParam": "page",
        "paramLocation": "url",
        "searchParam": "title"
      },
      "url": "/api/post/list?type=2\u0026orderType=1\u0026fileTypes=1\u0026page={page}\u0026limit={limit}\u0026title={query}"
    }
  },
  "description": "生存战争中文社区存档仓库 - 支持搜索和下载各种游戏存档",
  "enabled": true,
  "icon": "",
  "id": "12345",
  "isDefault": true,
  "name": "生存战争中文社区存档下载源示例",
  "type": "savegames"
}