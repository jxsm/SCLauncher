{
  "api": {
    "baseUrl": "https://m.suancaixianyu.cn",
    "endpoint": {
      "headers": {},
      "method": "GET",
      "pagination": {
        "limitParam": "limit",
        "pageParam": "page",
        "paramLocation": "url",
        "searchParam": "title"
      },
      "url": "/api/post/list?type=2\u0026orderType=3\u0026fileTypes=4\u0026page={page}\u0026limit={limit}"
    },
    "responseMapping": {
      "author": "$.creator.nickname",
      "authorAvatar": "$.creator.headImg",
      "cover": "$.cover",
      "description": "$.content",
      "downloadUrl": "$.files[0].url",
      "fileName": "$.files[0].filename",
      "fileSize": "$.files[0].size",
      "icon": "$.files[0].icon",
      "id": "$.id",
      "likes": "$.likeCount",
      "results": "$.data.list",
      "title": "$.title",
      "total": "$.data.total",
      "totalPages": "$.data.totalPages",
      "version": "$.version",
      "versions": "$.postVersions",
      "views": "$.views"
    },
    "search": {
      "headers": {},
      "method": "GET",
      "pagination": {
        "limitParam": "limit",
        "pageParam": "page",
        "paramLocation": "url",
        "searchParam": "title"
      },
      "url": "/api/post/list?type=2\u0026orderType=3\u0026fileTypes=4\u0026title={query}\u0026page={page}\u0026limit={limit}"
    }
  },
  "description": "生存战争中文社区皮肤仓库",
  "enabled": true,
  "icon": "",
