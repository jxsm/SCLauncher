{
  //固定，表示是生存战争的整合包（必须）
  "manifestType": "SurvivalcraftModpack",
  //清单版本号，告诉启动器使用哪个版本的解析器解析(当前只有0.1个，请填写0.1)(必填)
  "manifestVersion": 0.1,
  //==============基本信息=======
  "name": "整合包名称", //整合包名称(必填)
  "version": "1.0.0", //整合包版本(必填)
  "author": "作者名称", //作者(必填)
  "description": "描述", //简写描述(可选)
  "icon": "icon.png", //图标(可选)
  "created": "2025-01-01", // 创建时间(可选)
  "changelog": "首次发布", //更新日志(可选)
  // ============游戏核心配置=============
  "survivalcraft": {
    "version": {
      "android": {
        //(可选)如果不填用户在安装时会显示"该整合包不支持android"
        "version": "2.4:api-1.8.2.3", //(必填)填写整合包的版本号
        "apkPackageName": "com.candy.survivalcraftAPI1_8", // 如果整合包支持安卓，则此项必填，用于检测用户是否已经安装了该版本，如果不存在则会要求用户先安装该版本
        "path": "URL" // (可选)下载URL 如果填写了此项则下载时会使用这个链接进行下载(!!如果填写了该项目在安装时会提示用户注意风险)
      },
      "windows": {
        // (可选)如果不填用户在安装时会显示"该整合包不支持windows"
        "version": "2.4:api-1.8.2.3",
        "path": "URL" // (可选)下载URL 如果填写了此项则下载时会使用这个链接进行下载(!!如果填写了该项目在安装时会提示用户注意风险)
      } //
      //============命名规则=============
      //2.4 表示2.4的大版本  api:插件版  1.8.2.3 版本号
      //示例:
      //2.4:net-26.02.05 表示2.4的大版本  net联机版  26.02.05 版本号

      //=================特殊情况================
      //1:完整包 包含所有文件（游戏、Mod、配置）此时对应的平台应填写为"大版本号:carry/文件夹名(或apk名)"，并且在整合包的根目录下创建一个名为"carry"的文件夹
      //里面需要存放好相应的文件夹或apk文件
      //示例:
      //"windows":2.4:carry/1.8.2.3
      //"android":2.4:carry/1.8.2.3.apk
    },
    "versionList": {
      //(可选) 默认使用内置的
      "android": "URL", //安卓生存战争下载列表清单(可选) 默认使用启动器所选的
      "windows": "URL" //windows生存战争下载列表(可选) 默认使用启动器所选的
      // 版本列表中必须包含path,用于下载游戏....
    }
  },
  // ============模组列表=============
  "mods": [
    //模组列表(必填)(可以为空列表)
    {
      "projectID": 1630, //模组ID(必填), 该ID是在SCBBS上发布的文章的ID，示例:https://www.scbbs.top/#/postDetails/1630 
      "version": "1.1.0.2", //模组版本(必填) 资源下载中显示的版本号,可以是lastest 则下载最新的哪个版本
      "name": "模组名", //模组名(可选 方便调试) 资源下载中显示的模组名
      "required": true, //是否必须(必填) 如果为false 则如果在下载失败的情况下不会中断整合包的下载
      "path": "URL" //模组下载地址(可选) 如果填写了该地址则下载该地址的模组,否则下载SCBBS上的模组 (!!如果填写了该项目在安装时会提示用户注意风险)
    }
  ],
  "modPath":"/Mods", //模组存放路径(可选) 默认为/Mods 请注意，如果是联机版请填写"/NetMods"
  //======== 自定义覆盖文件 =============
  "overrides": "overrides", //自定义覆盖文件(可选) 如果有自定义覆盖文件则必须填写,该文件必须放在整合包根目录下
  //这个的意思就是，你在整合包根目录下创建一个名为overrides的文件夹，里面存放好你要覆盖的文件，启动器会自动覆盖到游戏目录下
  "checksum": "sha256" //校验方式(可选) 默认sha256 用于校验整合包的完整性
}
